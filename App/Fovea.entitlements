<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<!-- Distributed outside the App Store, so the app is NOT sandboxed (§10 of
	     the spec). Fovea has to read images referenced by relative path next to
	     the document, write into its asset folder, and save fonts dropped in by
	     the user. The sandbox would demand a security-scoped bookmark for each
	     of those, with no benefit outside the App Store. -->
</dict>
</plist>
